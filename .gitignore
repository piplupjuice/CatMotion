# generated by the pipeline, not by hand
__pycache__/
*.pyc

# 3 GB of film and 45 MB of weights do not belong in git.
# design_out/ and ckpt/ stay on the machine that rendered them; media/ holds the
# web-sized stills this README actually shows.
design_out/
ckpt/
data/

# the notebook and the cloud run are not part of this repository. every number in the
# README was produced by the .py files in src/ on one CPU machine, so the published
# project is the .py pipeline. the notebook generator, its generated notebook and the
# cloud logs stay local.
notebooks/
kaggle_push/
kaggle_log/
src/build_notebook.py
src/dryrun_notebook.py

# my own working notes. the README is the document for readers; these two are for me.
REPORT.md
INTERVIEW.md

# scratch from the audit runs
out_readme_audit.txt
out/film_audit_run.txt
out/verify_run.txt
out/dryrun_log.txt
out/dryrun_run_log.txt

# superseded draft renders. the final films and their logs are in; these were the
# lower-resolution proof-of-plumbing passes that came before them.
out/film_draft_log.txt
out/denoise_gt_draft_log.txt
